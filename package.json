		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"next": "^16.2.10",
		"next-intl": "^4.13.1",
		"next-themes": "^0.4.6",
		"nodemailer": "^9.0.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
